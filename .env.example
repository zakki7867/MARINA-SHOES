# Environment variables for MARINA SHOES ERP
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1

# Database
# Local development (SQLite):
DATABASE_URL=sqlite:///db.sqlite3
# Production (PostgreSQL):
# DATABASE_URL=postgres://marina_user:strong_password@localhost:5432/marina_shoes

# Store Defaults (Kuwait)
DEFAULT_CURRENCY_CODE=KWD
DEFAULT_CURRENCY_SYMBOL=KD
DEFAULT_STATE_CODE=KW
TIME_ZONE=Asia/Kuwait

# Production Security / Admin Overrides
# Set SECURE_SSL_REDIRECT=True when serving HTTPS in production
SECURE_SSL_REDIRECT=False
DB_CONN_MAX_AGE=60
DJANGO_ADMIN_URL=admin/
